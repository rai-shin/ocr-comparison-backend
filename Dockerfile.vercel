FROM python:3.12-slim-bookworm

WORKDIR /app

# Install Linux libraries required by OpenCV/PaddleOCR and Tesseract OCR.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libsm6 \
    libxext6 \
    libxrender1 \
    tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

# Configure Tesseract for Linux.
ENV TESSERACT_CMD=/usr/bin/tesseract
ENV PYTHONUNBUFFERED=1
ENV PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=False

# Install the existing pinned Python dependencies.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the existing FastAPI application.
COPY main.py .

# Vercel routes traffic to port 80 by default.
EXPOSE 80

CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-80}"]
